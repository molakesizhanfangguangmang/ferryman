# ferryman 配置。改完执行：docker compose up -d --force-recreate
#
# 取值规则：值里有空格/冒号/大括号，就用单引号包起来（原样取用，不做替换）。
# 每种目标类型要填哪些，见 README 的「目标类型」。下面按 generic 示例。

# ---- 通用 ----
# 监听端口（webhook 接收端；被别的服务占用就换一个）
LISTEN_PORT=8311
# 最多转发多少字符，超出截断
MAX_TEXT_LEN=1500
# 每条消息前面加的字，留空不加
TEXT_PREFIX=
# 正文里含这些词就整条吞掉、不转发（逗号分隔；留空=不过滤）
# 例：DROP_KEYWORDS=已入库
DROP_KEYWORDS=

# ---- 目标类型 ----
# generic / qwenpaw / wecom / dingtalk / feishu
TARGET_TYPE=generic

# ===== TARGET_TYPE=generic：POST 到你给的 URL，body 由模板渲染 =====
# {{{message}}} 原样替换；{{message}} HTML 转义；
# 模板去掉占位符后若是合法 JSON，文本会先按 JSON 字符串转义再塞进去（多行也不会破 JSON）。
# 反例：模板只写 {{{message}}} 这三个大括号时，是原样替换，不做转义。
# 判定条件：把占位符换成一个不带引号的小写 x 后仍是合法 JSON。所以 JSON 模板里
# 占位符要带引号（"{{{message}}}"），不带引号的（如 {"n": {{{message}}}}）会被当成非 JSON 模板。
TARGET_URL=http://127.0.0.1:8088/api/messages/send
TARGET_BODY='{"text": "{{{message}}}"}'
# 额外请求头，两种写法都行：{"X-Agent-Id": "<agent-id>"}  或  X-Agent-Id=<agent-id>
TARGET_HEADERS='{"X-Agent-Id": "<agent-id>"}'
TARGET_METHOD=POST

# ===== TARGET_TYPE=qwenpaw：发到 QwenPaw 的 /api/messages/send =====
# 说明：relay 与 QwenPaw 同机时 URL 填 http://127.0.0.1:8088/api/messages/send，
# 走回环才吃得到免鉴权白名单。AGENT_ID 必填＝用哪个 agent 的身份发（它会出现在会话里）。
QWENPAW_URL=http://127.0.0.1:8088/api/messages/send
AGENT_ID=
# 渠道，看你自己 QwenPaw 里开了哪个：qq / telegram / wecom / dingtalk / ...
CHANNEL=qq
TARGET_USER=
# 形如 qq:c2c:<用户ID> 或 qq:group:<群ID>；不确定就用 GET /api/sessions 查
TARGET_SESSION=

# ===== TARGET_TYPE=wecom：企业微信群机器人 =====
# 群设置 → 群机器人 → 添加 → 复制 Webhook 地址里的 key
WECOM_KEY=
# 或者直接给完整地址（给了它就不用 WECOM_KEY）
WECOM_URL=

# ===== TARGET_TYPE=dingtalk：钉钉群机器人 =====
DINGTALK_TOKEN=
DINGTALK_URL=
# 安全设置选「加签」时把密钥填这里（不签就留空）
DINGTALK_SECRET=

# ===== TARGET_TYPE=feishu：飞书自定义机器人 =====
# 机器人设置里 Webhook 地址的最后一段
FEISHU_TOKEN=
FEISHU_URL=
